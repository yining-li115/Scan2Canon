# Copy to .env.local and fill only the key for your chosen provider.
# Load explicitly: uv run --env-file .env.local ...
# Never commit .env.local. See docs/environment.md for commands and quota details.

# Local capture backend storage (independent of canonicalization run directories).
SCAN2CANON_DATA_DIR=.scan2canon

# Gemini Developer API: create a key in Google AI Studio.
# Leave the key blank in this tracked template. Fill it only in .env.local.
GEMINI_API_KEY=
# A free-tier option listed by Google on 2026-10-27; verify your project quota.
# --model overrides this value. No automatic provider or paid-model fallback.
GEMINI_MODEL=gemini-3.8-flash

# Optional OpenAI backend (--backend responses --model MODEL_ID).
# Leave empty when using Gemini; a Gemini key cannot authenticate with OpenAI.
OPENAI_API_KEY=
