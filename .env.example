# Copy to .env.local and fill only the key for your chosen provider.
# Load explicitly: uv run --env-file .env.local ...
# Never commit .env.local. See docs/environment.md for commands and quota details.

# Local capture backend storage (independent of canonicalization run directories).
SCAN2CANON_DATA_DIR=.scan2canon

# Gemini Developer API: create a key in Google AI Studio.
# Leave the key blank in this tracked template. Fill it only in .env.local.
GEMINI_API_KEY=
# A free-tier option listed by Google on 2026-10-27; verify your project quota.
# Evidence agent: HTTP 429 selects the next model from GEMINI_MODELS_FILE.
# --model pins one model and disables fallback. No automatic provider switch.
GEMINI_MODEL=gemini-3.8-flash
# The list is a reviewed Free-tier candidate pool, not live quota/billing detection.
GEMINI_MODELS_FILE=experiments/canonicalization/gemini-models.json

# Optional OpenAI backend (--backend responses --model MODEL_ID).
# Leave empty when using Gemini; a Gemini key cannot authenticate with OpenAI.
OPENAI_API_KEY=

# Optional Claude backend (--backend claude); promotional credit is not a free tier.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Stop BEFORE the credit expiry date, in UTC; update for your own grant.
# Empty disables this local date guard. It does not inspect billing or remaining credits.
ANTHROPIC_STOP_AT=2026-11-05T00:00:00+00:00
